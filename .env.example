# DiagramWeaver — local maintenance (icon generation via Ollama)
# Copy to `.env.local` and adjust values. Never commit `.env.local`.

# Client: URL of the maintenance API (must match MAINTENANCE_PORT below)
NEXT_PUBLIC_MAINTENANCE_API_URL=http://127.0.0.1:9005

# Server-only (read by scripts/maintenance-server.mjs)
MAINTENANCE_PORT=9005
MAINTENANCE_PASSWORD=change-me
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
