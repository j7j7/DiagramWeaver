# DiagramWeaver — local maintenance (icon generation via Ollama)
# Copy to `.env.local` for development. Do NOT set these for production static builds.

# --- Dev only: icon maintenance (beta) ---
# Omit NEXT_PUBLIC_* vars when running `npm run build` so `out/` has no maintenance UI/API wiring.
NEXT_PUBLIC_MAINTENANCE_MENU_ENABLED=true
NEXT_PUBLIC_MAINTENANCE_API_URL=http://127.0.0.1:9005

# Server-only (read by scripts/maintenance-server.mjs — not part of next build / out/)
MAINTENANCE_PORT=9005
MAINTENANCE_PASSWORD=change-me
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
