[Unit]
Description=DiagramWeaver Production Build Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/j7/code/github/DiagramWeaver
ExecStart=/home/j7/code/github/DiagramWeaver/start-secure-server.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/j7/code/github/DiagramWeaver/.next /home/j7/code/github/DiagramWeaver/.cache
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RemoveIPC=yes
UMask=022

# Resource limits
MemoryMax=512M
CPUQuota=50%
TasksMax=100


[Install]
WantedBy=default.target