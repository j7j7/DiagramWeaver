      "y": 80,
      "width": 600,
      "height": 150,
      "sizeMode": "custom",
      "orientation": "horizontal",
      "borderStyle": "dashed",
      "borderColor": "#3b82f6",
      "backgroundColor": "rgba(59, 130, 246, 0.05)",
      "textPosition": "top-left"
    }
  ]
