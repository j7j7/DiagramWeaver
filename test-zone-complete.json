      "label": "Web Server",
      "x": 150,
      "y": 120
    },
    {
      "id": "database",
      "type": "aws.database.rds",
      "label": "Database",
      "x": 350,
      "y": 120
    },
    {
      "id": "cache",
      "type": "aws.database.elasticache",
      "label": "Cache Layer",
      "x": 550,
      "y": 120
    }
  ],
  "connections": [
    {
      "id": "conn1",
      "from": "web-server",
